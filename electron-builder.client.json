{
  "appId": "com.blackboard.chat.client",
  "productName": "Black Board Connect",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "electron/client.js",
    "electron/preload-connect.js",
    "public/connect.html",
    "public/connect.js",
    "public/style.css",
    "package.json"
  ],
  "asar": true,
  "artifactName": "${productName}-Setup-${version}.${ext}",
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "build/icon.png",
      "to": "icon.png"
    }
  ],
  "extraMetadata": {
    "main": "electron/client.js"
  },
  "win": {
    "icon": "icon.ico",
    "signAndEditExecutable": true,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Black Board Connect",
    "installerLanguages": ["ja_JP", "en_US"],
    "language": "1041",
    "deleteAppDataOnUninstall": false
  }
}
